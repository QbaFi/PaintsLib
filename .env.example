# Copy this file to ".env" only if you want to change something. Everything works without it.

# Port in your browser: http://localhost:8080
PORT=8080

# Default brand used for "equivalent" suggestions (can also be changed in the app settings).
REFERENCE_BRAND=citadel

# Import the paint catalog automatically on first start.
AUTO_IMPORT=true

# Import every brand from the source (~10k paints) instead of only the MVP brands.
IMPORT_ALL_BRANDS=false
